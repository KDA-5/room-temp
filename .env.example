# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 `.env` 로 이름을 바꾸고 값을 채우세요.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS:    cp .env.example .env
# `.env` 는 .gitignore 에 들어 있어서 깃에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 브라우저에 노출되는 값 (VITE_ 접두사) ──────────────────────
# Supabase 대시보드 → Project Settings → Data API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 같은 화면의 anon / public key.
# 이 키는 원래 브라우저에 공개되는 용도라 노출돼도 괜찮습니다.
# 실제 보호는 schema.sql 의 RLS 정책이 담당해요.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 강의실 인원. 참여율 표시에만 씁니다. (수강생 33 + 강사 1 + 보조강사 2)
VITE_ROOM_SIZE=36

# 강의실 위치 (날씨·습도 조회용). 서울 성수동 기준.
VITE_LAT=37.5447
VITE_LON=127.0557


# ── 서버에서만 쓰는 값 (VITE_ 없음 · 브라우저로 안 나감) ────────
# Vercel 대시보드 → Settings → Environment Variables 에도 똑같이 넣어주세요.

# Supabase → Project Settings → API → service_role key.
# 절대 VITE_ 를 붙이지 마세요. 붙이면 브라우저로 새어나갑니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 슬랙 알림을 안 쓸 거면 비워두세요. 비어 있으면 알림 기능만 조용히 꺼집니다.
# 발급: api.slack.com/apps → 앱 생성 → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# 배포된 사이트 주소. 슬랙 메시지에 들어갈 링크입니다.
PUBLIC_SITE_URL=https://room-temp.vercel.app
